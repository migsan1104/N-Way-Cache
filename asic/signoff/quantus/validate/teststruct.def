VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN teststruct ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 3000000 3000000 ) ;

NONDEFAULTRULES 14 ;
- ndr_met1_1000 + LAYER met1 WIDTH 1000 ;
- ndr_met1_2000 + LAYER met1 WIDTH 2000 ;
- ndr_met1_50000 + LAYER met1 WIDTH 50000 ;
- ndr_met2_1000 + LAYER met2 WIDTH 1000 ;
- ndr_met2_2000 + LAYER met2 WIDTH 2000 ;
- ndr_met2_50000 + LAYER met2 WIDTH 50000 ;
- ndr_met3_1000 + LAYER met3 WIDTH 1000 ;
- ndr_met3_2000 + LAYER met3 WIDTH 2000 ;
- ndr_met3_50000 + LAYER met3 WIDTH 50000 ;
- ndr_met4_1000 + LAYER met4 WIDTH 1000 ;
- ndr_met4_2000 + LAYER met4 WIDTH 2000 ;
- ndr_met4_50000 + LAYER met4 WIDTH 50000 ;
- ndr_met5_2000 + LAYER met5 WIDTH 2000 ;
- ndr_met5_50000 + LAYER met5 WIDTH 50000 ;
END NONDEFAULTRULES

PINS 20 ;
- p_met1 + NET p_met1 + DIRECTION INPUT + USE SIGNAL
  + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 200000 325000 ) N ;
- w_met1 + NET w_met1 + DIRECTION INPUT + USE SIGNAL
  + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 200000 1500000 ) N ;
- m10_met1 + NET m10_met1 + DIRECTION INPUT + USE SIGNAL
  + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 300000 1500000 ) N ;
- m20_met1 + NET m20_met1 + DIRECTION INPUT + USE SIGNAL
  + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 400000 1500000 ) N ;
- p_met2 + NET p_met2 + DIRECTION INPUT + USE SIGNAL
  + LAYER met2 ( -70 -70 ) ( 70 70 ) + PLACED ( 700000 325000 ) N ;
- w_met2 + NET w_met2 + DIRECTION INPUT + USE SIGNAL
  + LAYER met2 ( -70 -70 ) ( 70 70 ) + PLACED ( 700000 1500000 ) N ;
- m10_met2 + NET m10_met2 + DIRECTION INPUT + USE SIGNAL
  + LAYER met2 ( -70 -70 ) ( 70 70 ) + PLACED ( 800000 1500000 ) N ;
- m20_met2 + NET m20_met2 + DIRECTION INPUT + USE SIGNAL
  + LAYER met2 ( -70 -70 ) ( 70 70 ) + PLACED ( 900000 1500000 ) N ;
- p_met3 + NET p_met3 + DIRECTION INPUT + USE SIGNAL
  + LAYER met3 ( -150 -150 ) ( 150 150 ) + PLACED ( 1200000 325000 ) N ;
- w_met3 + NET w_met3 + DIRECTION INPUT + USE SIGNAL
  + LAYER met3 ( -150 -150 ) ( 150 150 ) + PLACED ( 1200000 1500000 ) N ;
- m10_met3 + NET m10_met3 + DIRECTION INPUT + USE SIGNAL
  + LAYER met3 ( -150 -150 ) ( 150 150 ) + PLACED ( 1300000 1500000 ) N ;
- m20_met3 + NET m20_met3 + DIRECTION INPUT + USE SIGNAL
  + LAYER met3 ( -150 -150 ) ( 150 150 ) + PLACED ( 1400000 1500000 ) N ;
- p_met4 + NET p_met4 + DIRECTION INPUT + USE SIGNAL
  + LAYER met4 ( -150 -150 ) ( 150 150 ) + PLACED ( 1700000 325000 ) N ;
- w_met4 + NET w_met4 + DIRECTION INPUT + USE SIGNAL
  + LAYER met4 ( -150 -150 ) ( 150 150 ) + PLACED ( 1700000 1500000 ) N ;
- m10_met4 + NET m10_met4 + DIRECTION INPUT + USE SIGNAL
  + LAYER met4 ( -150 -150 ) ( 150 150 ) + PLACED ( 1800000 1500000 ) N ;
- m20_met4 + NET m20_met4 + DIRECTION INPUT + USE SIGNAL
  + LAYER met4 ( -150 -150 ) ( 150 150 ) + PLACED ( 1900000 1500000 ) N ;
- p_met5 + NET p_met5 + DIRECTION INPUT + USE SIGNAL
  + LAYER met5 ( -800 -800 ) ( 800 800 ) + PLACED ( 2200000 325000 ) N ;
- w_met5 + NET w_met5 + DIRECTION INPUT + USE SIGNAL
  + LAYER met5 ( -800 -800 ) ( 800 800 ) + PLACED ( 2200000 1500000 ) N ;
- m16_met5 + NET m16_met5 + DIRECTION INPUT + USE SIGNAL
  + LAYER met5 ( -800 -800 ) ( 800 800 ) + PLACED ( 2300000 1500000 ) N ;
- m20_met5 + NET m20_met5 + DIRECTION INPUT + USE SIGNAL
  + LAYER met5 ( -800 -800 ) ( 800 800 ) + PLACED ( 2400000 1500000 ) N ;
END PINS

NETS 20 ;
- p_met1 ( PIN p_met1 ) + NONDEFAULTRULE ndr_met1_50000
  + ROUTED met1 ( 200000 325000 ) ( 250000 325000 ) ;
- w_met1 ( PIN w_met1 )
  + ROUTED met1 ( 200000 1500000 ) ( 200000 2500000 ) ;
- m10_met1 ( PIN m10_met1 ) + NONDEFAULTRULE ndr_met1_1000
  + ROUTED met1 ( 300000 1500000 ) ( 300000 2500000 ) ;
- m20_met1 ( PIN m20_met1 ) + NONDEFAULTRULE ndr_met1_2000
  + ROUTED met1 ( 400000 1500000 ) ( 400000 2500000 ) ;
- p_met2 ( PIN p_met2 ) + NONDEFAULTRULE ndr_met2_50000
  + ROUTED met2 ( 700000 325000 ) ( 750000 325000 ) ;
- w_met2 ( PIN w_met2 )
  + ROUTED met2 ( 700000 1500000 ) ( 700000 2500000 ) ;
- m10_met2 ( PIN m10_met2 ) + NONDEFAULTRULE ndr_met2_1000
  + ROUTED met2 ( 800000 1500000 ) ( 800000 2500000 ) ;
- m20_met2 ( PIN m20_met2 ) + NONDEFAULTRULE ndr_met2_2000
  + ROUTED met2 ( 900000 1500000 ) ( 900000 2500000 ) ;
- p_met3 ( PIN p_met3 ) + NONDEFAULTRULE ndr_met3_50000
  + ROUTED met3 ( 1200000 325000 ) ( 1250000 325000 ) ;
- w_met3 ( PIN w_met3 )
  + ROUTED met3 ( 1200000 1500000 ) ( 1200000 2500000 ) ;
- m10_met3 ( PIN m10_met3 ) + NONDEFAULTRULE ndr_met3_1000
  + ROUTED met3 ( 1300000 1500000 ) ( 1300000 2500000 ) ;
- m20_met3 ( PIN m20_met3 ) + NONDEFAULTRULE ndr_met3_2000
  + ROUTED met3 ( 1400000 1500000 ) ( 1400000 2500000 ) ;
- p_met4 ( PIN p_met4 ) + NONDEFAULTRULE ndr_met4_50000
  + ROUTED met4 ( 1700000 325000 ) ( 1750000 325000 ) ;
- w_met4 ( PIN w_met4 )
  + ROUTED met4 ( 1700000 1500000 ) ( 1700000 2500000 ) ;
- m10_met4 ( PIN m10_met4 ) + NONDEFAULTRULE ndr_met4_1000
  + ROUTED met4 ( 1800000 1500000 ) ( 1800000 2500000 ) ;
- m20_met4 ( PIN m20_met4 ) + NONDEFAULTRULE ndr_met4_2000
  + ROUTED met4 ( 1900000 1500000 ) ( 1900000 2500000 ) ;
- p_met5 ( PIN p_met5 ) + NONDEFAULTRULE ndr_met5_50000
  + ROUTED met5 ( 2200000 325000 ) ( 2250000 325000 ) ;
- w_met5 ( PIN w_met5 )
  + ROUTED met5 ( 2200000 1500000 ) ( 2200000 2500000 ) ;
- m16_met5 ( PIN m16_met5 )
  + ROUTED met5 ( 2300000 1500000 ) ( 2300000 2500000 ) ;
- m20_met5 ( PIN m20_met5 ) + NONDEFAULTRULE ndr_met5_2000
  + ROUTED met5 ( 2400000 1500000 ) ( 2400000 2500000 ) ;
END NETS

END DESIGN
