# --- ASIC flow ---------------------------------------------------------------
# Everything under asic/PPA/ is regenerable tool output (reports, netlists,
# work databases, logs). Only the collected results table is tracked.
asic/PPA/**
!asic/PPA/RESULTS.md

# Innovus place-and-route output: reports, stage checkpoints (.enc, hundreds of
# MB each and ten per run), netlists, GDS, SPEF, logs. The scripts and
# constraints under asic/PnR/innovus/ stay tracked - only the output does not.
asic/PnR/innovus/runs/
asic/PnR/innovus/reports/
asic/PnR/innovus/checkpoints/
asic/PnR/innovus/outputs/
!asic/PnR/innovus/*/.gitkeep

# Compiled standard-cell database, rebuilt by run_dc.sh when absent.
asic/libraries/sky130_fd_sc_hd/db/
asic/libraries/sky130_fd_sc_hd/*.log
asic/libraries/sky130_fd_sc_hd/*.out

# Tool droppings. The launchers now run inside asic/PPA/<tool>/assoc_<N>/work,
# so these should no longer appear at the repository root -- kept as a backstop.
alib-*
moduleparamid
.pbs_*/
cds.lib
lc_output.txt
lc_command.log
genus.cmd*
genus.log*
genus.history*
command.log
default.svf
*.mr
*.pvl
*.syn
*.svf
# *.pvl above is a Design Compiler intermediate; Pegasus rule decks share the
# extension and ARE source
!asic/signoff/pegasus/decks/*.pvl

# Magic extraction debris - a signoff run with cwd at the repo root scatters
# per-cell .ext files here (regenerable; the LVS scripts now cd first)
/*.ext

*.sdc.gz
*.v.gz
*.hdb
*.db
*.dbs
*.snapshot

# Per-associativity OpenFLEX build directories. timing.sh gives each run its own
# so the sweep can execute in parallel; all of it is regenerable Vivado output.
openflex/.build_assoc*/
openflex/timing_assoc*_stdout.log
*.bak

# Private optimization lab notebook (see optimizations.md header).
optimizations.md
__pycache__/

# OpenRAM generated macro output: multi-MB GDS/SPICE/LIB per macro, fully
# regenerable from the checked-in configs (asic/openram/*.py) via
# asic/openram/run_openram.sh. Same policy as asic/PPA output.
asic/openram/*_out/
asic/openram/*_run.log
Resume/

# --- P&R / signoff campaign (2026-09-01 cleanup) ------------------------------
# Innovus scratch at the innovus/ dir level (stage output dirs are ignored
# above; these are the tool droppings from interactive/snap sessions).
asic/PnR/innovus/logs/
asic/PnR/innovus/timingReports/
asic/PnR/innovus/work/
asic/PnR/innovus/lef/
asic/PnR/innovus/*.log*
asic/PnR/innovus/*.logv*
asic/PnR/innovus/*.cmd*
asic/PnR/innovus/*.gif
asic/PnR/innovus/*.lef
asic/PnR/innovus/innovus_temp_*
asic/PnR/innovus/scheduling_file.*

# Signoff tool output: Magic/netgen extraction debris, Quantus work dir,
# per-run results (SPEF/STA/IR). The scripts, docs, techfiles and the
# GDS11_Image renders stay tracked.
asic/signoff/*.ext
asic/signoff/results/
asic/signoff/quantus/work_*/
asic/signoff/*.log
asic/signoff/GDS11_Image/*.raw.png

# Xcelium scratch + misc droppings
xcelium/xcelium.d/
xcelium/logs/
.rs_*.tstamp
*.bak_*
asic/openram/debug_*/
asic/openram/bsim4v5.out

# Stale 4KB-era formal-verification output (capacity deprecated 2026-08-20).
fv/

# Archived/snapshotted Vivado runs and validation output: on-disk reference
# copies, not repo material (the live outputs/ stay tracked per convention).
openflex/PPA/*/archive/
openflex/PPA/snapshot_*/
asic/PnR/innovus/.timing_file_*
asic/signoff/quantus/validate/out_*/
# Voltus debris and regenerable power-grid views (2026-09-04): run_pgv.sh
# rebuilds pgv/ in ~1 min (techonly); pm.ob/.stat/cellIDMap/work are tool
# scratch written next to the launch directory.
asic/signoff/voltus/pgv/
asic/signoff/voltus/work/
asic/signoff/voltus/.stat/
asic/signoff/voltus/cellIDMap
asic/signoff/**/pm.ob

# Voltus/Innovus scratch under signoff/ (2026-09-05)
asic/signoff/.stat/
asic/signoff/work/
asic/signoff/cellIDMap

# Magic .ext debris from LVS runs whose cwd was asic/ or asic/PnR/innovus/
# (2026-09-08: 750+ files); regenerable, the signoff scripts cd into work/
asic/*.ext
asic/PnR/innovus/*.ext
# Innovus / Xcelium droppings when a tool is launched from the repo root or scripts/
.stat/
**/.stat/
cellIDMap
pm.ob
/work/
asic/PnR/innovus/scripts/work/
asic/work/
xcelium/*.sdf.X
xcelium/xrun.key

